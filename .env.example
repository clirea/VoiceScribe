# VoiceScribe環境設定サンプル
# 実際に使用する場合は、このファイルを.envにコピーし、使うサービスの行だけ # を外して値を設定してください
# （your_xxx_here のままの値は未設定として扱われます）

# OpenAI API設定（-s openai を使用する場合）
# OPENAI_API_KEY=your_openai_api_key_here

# Groq API設定（-s groq を使用する場合）
# GROQ_API_KEY=your_groq_api_key_here

# Google Cloud Speech-to-Text設定（-s google でサービスアカウントを使用する場合）
# サービスアカウントJSONファイルのパスを指定し、`pip install -r requirements-google-cloud.txt` を実行してください
# （旧名称 GOOGLE_API_KEY に設定したJSON文字列・ファイルパスも引き続き使用できます）
# 設定しない場合は無料枠のGoogle Speech Recognition（リクエスト数に制限あり）が使用されます
# GOOGLE_CLOUD_CREDENTIALS_JSON=path/to/service_account.json
